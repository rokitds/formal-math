---
import Base from "./Base.astro";

interface Props {
  frontmatter: {
    title: string;
    week: number;
    summary: string;
    time: string;
  };
}
const { title, week, summary, time } = Astro.props.frontmatter;
---
<Base title={`Week ${week}: ${title}`} description={summary}>
  <p class="eyebrow">Week {week} · {time}</p>
  <h1>{title}</h1>
  <p class="summary">{summary}</p>
  <slot />
</Base>

<style>
  .eyebrow {
    color: var(--accent);
    font-weight: 600;
    margin-bottom: 0;
  }
  h1 {
    margin-top: 0.3rem;
  }
  .summary {
    color: var(--muted);
    font-size: 1.1rem;
  }
</style>
